# =====================================================================
# MADOCS DR Screening System - Backend Environment Configuration Example
# =====================================================================

# Database Connection URL (MySQL Production / SQLite Local Fallback)
# MySQL Format: mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?charset=utf8mb4
# SQLite Fallback: sqlite:///./madocs_local.db
DATABASE_URL=sqlite:///./madocs_local.db

# Model and Server Settings
DR_CONFIDENCE_THRESHOLD=0.60
BASE_SERVER_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# WhatsApp Cloud API Configuration (Optional / Demo fallback active if unset)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=madocs_verify_token_2026
WHATSAPP_ENVIRONMENT=demo

# Phase 14: Outbound Email / SMTP Provider Configuration
# Set these variables in backend/.env to enable verified real outbound email delivery.
# If unset, the backend will report 'Email service is not configured.' and block dispatches.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=MADOCS DR Screening AI <your-email@gmail.com>